; Aspen Plus Input File for Methanol Plant (10,000 TPD)
; Generated by Antigravity
;
; DESIGN BASIS:
; Product: Grade AA Methanol (10,000 TPD)
; Feed: Natural Gas (100% CH4)
; Method: Autothermal Reforming (ATR)

TITLE 'Methanol Plant 10k TPD'

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C FLOW='KG/HR'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC' / 'NOASPENPCD'

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC'

COMPONENTS
    CH4 METHANE /
    H2O WATER /
    O2 OXYGEN /
    CO CARBON-MONOXIDE /
    CO2 CARBON-DIOXIDE /
    H2 HYDROGEN /
    CH3OH METHANOL /
    N2 NITROGEN

; Property Method: RK-SOAVE for High Pressure Gas Processing
PROPERTIES RK-SOAVE 

; ----------------------------------------------------------------
; FLOWSHEET CONNECTIVITY
; ----------------------------------------------------------------

FLOWSHEET
    ; Section 1: Reforming (ATR)
    BLOCK MIX-FEED IN=NG-FEED STEAM O2-FEED OUT=ATR-IN
    BLOCK B-ATR    IN=ATR-IN OUT=HOT-SYN
    BLOCK B-COOL   IN=HOT-SYN OUT=COLD-SYN
    BLOCK B-FLASH  IN=COLD-SYN OUT=DRY-GAS WATER-DR
    
    ; Section 2: Compression
    BLOCK B-COMP   IN=DRY-GAS OUT=HP-GAS
    
    ; Section 3: Synthesis Loop
    BLOCK MIX-LOOP IN=HP-GAS RECYCLE OUT=R-IN
    BLOCK B-SYN    IN=R-IN OUT=R-OUT
    BLOCK B-SEP    IN=R-OUT OUT=GAS-PURG CRUDE-ME
    BLOCK SPLIT    IN=GAS-PURG OUT=PURGE RECYCLE

    ; Section 4: Purification (Simplified to 1 column for V1)
    BLOCK B-DIST   IN=CRUDE-ME OUT=MEOH-PRO WASTE-H2O

; ----------------------------------------------------------------
; STREAMS
; ----------------------------------------------------------------

; Feed: 10,000 TPD Product approx requires ~300,000 kg/hr NG (Need calculation)
; Mass Balance Estimate: CH4 (16) -> CH3OH (32). Ratio 1:2 mass? 
; Molar 1:1. 1 kmole CH4 -> 1 kmol MeOH. 16kg -> 32kg.
; 10,000 Tonnes/Day = 416,666 kg/hr. 
; Theoretical Methane needed = 208,333 kg/hr.
; With efficiency losses, let's start with 220,000 kg/hr Methane.

STREAM NG-FEED
    SUBSTREAM MIXED TEMP=40 PRES=30 MASS-FLOW=220000
    MOLE-FRAC CH4 1.0

STREAM STEAM
    SUBSTREAM MIXED TEMP=250 PRES=35
    ; S/C ratio ~ 0.6 (Molar). CH4 MW=16, H2O MW=18.
    ; Moles CH4 = 220,000/16 = 13,750 kmol/hr
    ; Steam = 0.6 * 13,750 = 8,250 kmol/hr
    ; Mass Steam = 8,250 * 18 = 148,500 kg/hr
    MASS-FLOW 148500
    MOLE-FRAC H2O 1.0

STREAM O2-FEED
    SUBSTREAM MIXED TEMP=150 PRES=30
    ; Stoichiometry for Partial Ox: CH4 + 0.5 O2 -> CO + 2H2
    ; Need approx 0.5-0.6 mole O2 per mole CH4 for ATR
    ; Moles O2 = 0.6 * 13750 = 8250 kmol/hr
    ; Mass O2 = 8250 * 32 = 264,000 kg/hr
    MASS-FLOW 264000
    MOLE-FRAC O2 1.0

; ----------------------------------------------------------------
; BLOCKS
; ----------------------------------------------------------------

; Block 1: Feed Mixer
BLOCK MIX-FEED MIXER

; Block 2: ATR Reactor (Gibbs Minimization for Reforming)
BLOCK B-ATR RGIBBS
    PARAM TEMP=1000 PRES=30

; Block 3: Syngas Cooler
BLOCK B-COOL HEATER
    PARAM TEMP=40 PRES=0 ; 0 drop

; Block 4: Water Knockout
BLOCK B-FLASH FLASH2
    PARAM TEMP=40 PRES=0 

; Block 5: Compressor (Multi-stage)
BLOCK B-COMP COMPR
    PARAM PRES=80 TYPE=ISENTROPIC EFF=0.85

; Block 6: Loop Mixer
BLOCK MIX-LOOP MIXER

; Block 7: Methanol Synthesis Reactor (Equilibrium)
; CO + 2H2 <-> CH3OH
BLOCK B-SYN REQUIL
    PARAM TEMP=250 PRES=80
    REACTIONS RXN-SET1

; Block 8: High Pressure Separator
BLOCK B-SEP FLASH2
    PARAM TEMP=40 PRES=0

; Block 9: Purge Splitter
BLOCK SPLIT FSPLIT
    FRAC RECYCLE 0.95 

; Block 10: Distillation (Simple Separation for V1)
BLOCK B-DIST SEP
    PARAM
    FRAC STRM=MEOH-PRO SUBSTRM=MIXED COMP=CH3OH FRAC=0.99
    FRAC STRM=MEOH-PRO SUBSTRM=MIXED COMP=H2O   FRAC=0.001
    ; Rest goes to waste

; ----------------------------------------------------------------
; CHEMISTRY & REACTIONS
; ----------------------------------------------------------------

CHEMISTRY GLOBAL
    STOIC 1 CO -1 / H2 -2 / CH3OH 1
    STOIC 2 CO2 -1 / H2 -3 / CH3OH 1 / H2O 1

REACTIONS RXN-SET1 REQUIL
    REAC-DATA 1
    REAC-DATA 2

; ----------------------------------------------------------------
; DESIGN SPECS (Optimization loop)
; ----------------------------------------------------------------
; To be added in later phases: Adjust Feed to hit 10,000 TPD
