TITLE 'METHANOL PLANT 10K TPD'

; 10,000 TPD Grade AA Methanol via Autothermal Reforming (ATR)

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C FLOW='KG/HR'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC' / 'NOASPENPCD'

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC'

COMPONENTS
    CH4 METHANE /
    H2O WATER /
    O2 OXYGEN /
    CO CARBON-MONOXIDE /
    CO2 CARBON-DIOXIDE /
    H2 HYDROGEN /
    CH3OH METHANOL /
    N2 NITROGEN /

PROPERTIES RK-SOAVE

FLOWSHEETING
    MASS-BAL=YES ENERGY-BAL=YES

FLOWSHEET
    BLOCK MIX-FEED IN=NG-FEED STEAM O2-FEED OUT=ATR-IN
    BLOCK B-ATR IN=ATR-IN OUT=HOT-SYN
    BLOCK B-COOL IN=HOT-SYN OUT=COLD-SYN
    BLOCK B-FLASH IN=COLD-SYN OUT=DRY-GAS WATER-DR
    BLOCK B-COMP IN=DRY-GAS OUT=HP-GAS
    BLOCK MIX-LOOP IN=HP-GAS RECYCLE OUT=R-IN
    BLOCK B-SYN IN=R-IN OUT=R-OUT
    BLOCK B-SEP IN=R-OUT OUT=GAS-PURG CRUDE-ME
    BLOCK SPLIT IN=GAS-PURG OUT=PURGE RECYCLE
    BLOCK B-DIST IN=CRUDE-ME OUT=MEOH-PRO WASTE-H2O

STREAM NG-FEED
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 &
        MASS-FLOW=220000.0
    MOLE-FRAC MIXED &
        CH4 1.0 /

STREAM STEAM
    SUBSTREAM MIXED TEMP=250.0 PRES=35.0 &
        MASS-FLOW=148500.0
    MOLE-FRAC MIXED &
        H2O 1.0 /

STREAM O2-FEED
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 &
        MASS-FLOW=264000.0
    MOLE-FRAC MIXED &
        O2 0.995 / &
        N2 0.005 /

STREAM ATR-IN
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 &
        MASS-FLOW=632500.0
    MOLE-FRAC MIXED &
        CH4 0.455 / &
        H2O 0.273 / &
        O2 0.271 / &
        N2 0.001 /

STREAM HOT-SYN
    SUBSTREAM MIXED TEMP=1000.0 PRES=30.0 &
        MASS-FLOW=632500.0
    MOLE-FRAC MIXED &
        H2 0.48 / &
        CO 0.18 / &
        CO2 0.09 / &
        H2O 0.2 / &
        CH4 0.05 /

STREAM COLD-SYN
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 &
        MASS-FLOW=632500.0
    MOLE-FRAC MIXED &
        H2 0.48 / &
        CO 0.18 / &
        CO2 0.09 / &
        H2O 0.2 / &
        CH4 0.05 /

STREAM DRY-GAS
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 &
        MASS-FLOW=520000.0
    MOLE-FRAC MIXED &
        H2 0.62 / &
        CO 0.2 / &
        CO2 0.1 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM WATER-DR
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 &
        MASS-FLOW=112500.0
    MOLE-FRAC MIXED &
        H2O 0.985 / &
        CH3OH 0.005 / &
        CO2 0.005 / &
        CH4 0.005 /

STREAM HP-GAS
    SUBSTREAM MIXED TEMP=120.0 PRES=80.0 &
        MASS-FLOW=520000.0
    MOLE-FRAC MIXED &
        H2 0.62 / &
        CO 0.2 / &
        CO2 0.1 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM RECYCLE
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 &
        MASS-FLOW=1558000.0
    MOLE-FRAC MIXED &
        H2 0.66 / &
        CO 0.14 / &
        CO2 0.12 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM R-IN
    SUBSTREAM MIXED TEMP=220.0 PRES=80.0 &
        MASS-FLOW=2078000.0
    MOLE-FRAC MIXED &
        H2 0.65 / &
        CO 0.155 / &
        CO2 0.115 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM R-OUT
    SUBSTREAM MIXED TEMP=250.0 PRES=80.0 &
        MASS-FLOW=2090000.0
    MOLE-FRAC MIXED &
        H2 0.58 / &
        CO 0.1 / &
        CO2 0.11 / &
        CH4 0.07 / &
        H2O 0.08 / &
        CH3OH 0.06 /

STREAM GAS-PURG
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 &
        MASS-FLOW=1640000.0
    MOLE-FRAC MIXED &
        H2 0.66 / &
        CO 0.14 / &
        CO2 0.12 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM CRUDE-ME
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 &
        MASS-FLOW=460000.0
    MOLE-FRAC MIXED &
        CH3OH 0.905 / &
        H2O 0.085 / &
        CO2 0.005 / &
        CO 0.003 / &
        H2 0.002 /

STREAM PURGE
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 &
        MASS-FLOW=82000.0
    MOLE-FRAC MIXED &
        H2 0.66 / &
        CO 0.14 / &
        CO2 0.12 / &
        CH4 0.06 / &
        H2O 0.02 /

STREAM MEOH-PRO
    SUBSTREAM MIXED TEMP=40.0 PRES=1.5 &
        MASS-FLOW=416666.7
    MOLE-FRAC MIXED &
        CH3OH 0.9985 / &
        H2O 0.001 / &
        CO2 0.0003 / &
        CO 0.0001 / &
        CH4 0.0001 /

STREAM WASTE-H2O
    SUBSTREAM MIXED TEMP=45.0 PRES=1.2 &
        MASS-FLOW=43333.3
    MOLE-FRAC MIXED &
        H2O 0.96 / &
        CH3OH 0.03 / &
        CO2 0.005 / &
        CO 0.003 / &
        H2 0.002 /

BLOCK MIX-FEED MIXER

BLOCK B-ATR RGIBBS
    PARAM &
        TEMP=1000.0 &
        PRES=30.0

BLOCK B-COOL HEATER
    PARAM &
        TEMP=40.0 &
        PRES=0.0

BLOCK B-FLASH FLASH2
    PARAM &
        TEMP=40.0 &
        PRES=0.0

BLOCK B-COMP COMPR
    PARAM &
        PRES=80.0 &
        TYPE=ISENTROPIC &
        EFF=0.85

BLOCK MIX-LOOP MIXER

BLOCK B-SYN REQUIL
    PARAM &
        TEMP=250.0 &
        PRES=80.0
    REACTIONS RXN-SET1

BLOCK B-SEP FLASH2
    PARAM &
        TEMP=40.0 &
        PRES=0.0

BLOCK SPLIT FSPLIT
    FRAC RECYCLE 0.95
    FRAC PURGE 0.05

BLOCK B-DIST SEP
    PARAM
    FRAC STRM=MEOH-PRO SUBSTRM=MIXED COMP=CH3OH FRAC=0.99 &
    FRAC STRM=MEOH-PRO SUBSTRM=MIXED COMP=H2O FRAC=0.001 &

CHEMISTRY GLOBAL
    STOIC 1 CO -1.0 &
        H2 -2.0 / &
        CH3OH 1.0 /
    STOIC 2 CO2 -1.0 &
        H2 -3.0 / &
        CH3OH 1.0 / &
        H2O 1.0 /

REACTIONS RXN-SET1 REQUIL
    REAC-DATA 1
    K-STOIC 1 12.28 -4048.0 0.0 0.0
    REAC-DATA 2
    K-STOIC 2 10.59 -4800.0 0.0 0.0
