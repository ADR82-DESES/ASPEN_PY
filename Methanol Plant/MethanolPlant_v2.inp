TITLE    'Methanol Plant 10k TPD - ATR Process'

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C MASS-FLOW='KG/HR'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / &
        'APV140 SOLIDS' / 'APV140 INORGANIC' / 'NOASPENPCD'

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / &
        'APV140 SOLIDS' / 'APV140 INORGANIC'

COMPONENTS
    CH4 CH4 /
    H2O H2O /
    O2 O2 /
    CO CO /
    CO2 CO2 /
    H2 H2 /
    MEOH CH4O /
    N2 N2

PROPERTIES RK-SOAVE

FLOWSHEET
    BLOCK MIX-FEED IN=NG-FEED STEAM O2-FEED OUT=ATR-IN
    BLOCK B-ATR IN=ATR-IN OUT=HOT-SYN
    BLOCK B-COOL IN=HOT-SYN OUT=COLD-SYN
    BLOCK B-FLASH IN=COLD-SYN OUT=DRY-GAS WATER-DR
    BLOCK B-COMP IN=DRY-GAS OUT=HP-GAS
    BLOCK MIX-LOOP IN=HP-GAS RECYCLE OUT=R-IN
    BLOCK B-SYN IN=R-IN OUT=R-OUT
    BLOCK B-SEP IN=R-OUT OUT=GAS-PURG CRUDE-ME
    BLOCK SPLIT IN=GAS-PURG OUT=PURGE RECYCLE
    BLOCK B-DIST IN=CRUDE-ME OUT=MEOH-PRO WASTE-H2O

STREAM NG-FEED
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0
    MASS-FLOW=220000.0
    MASS-FRAC CH4 1.0

STREAM STEAM
    SUBSTREAM MIXED TEMP=250.0 PRES=35.0
    MASS-FLOW=148500.0
    MASS-FRAC H2O 1.0

STREAM O2-FEED
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0
    MASS-FLOW=264000.0
    MASS-FRAC O2 1.0

BLOCK MIX-FEED MIXER
    PARAM

BLOCK B-ATR RGIBBS
    PARAM TEMP=1000.0 PRES=30.0
    PROD H2 / CO / CO2 / H2O / CH4

BLOCK B-COOL HEATER
    PARAM TEMP=40.0 PRES=30.0

BLOCK B-FLASH FLASH2
    PARAM TEMP=40.0 PRES=30.0

BLOCK B-COMP COMPR
    PARAM TYPE=ISENTROPIC PRES=80.0
    BLOCK-OPTION FREE-WATER=NO

BLOCK MIX-LOOP MIXER
    PARAM

BLOCK B-SYN RSTOIC
    PARAM TEMP=250.0 PRES=80.0
    STOIC 1 MIXED CO -1.0 / H2 -2.0 / MEOH 1.0
    CONV 1 MIXED CO 0.25

BLOCK B-SEP FLASH2
    PARAM TEMP=40.0 PRES=80.0

BLOCK SPLIT FSPLIT
    FRAC RECYCLE 0.95

BLOCK B-DIST SEP
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=MEOH FRACS=0.995
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=H2O FRACS=0.001
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=CO FRACS=0.0
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=CO2 FRACS=0.0
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=H2 FRACS=0.0
    FRAC STREAM=MEOH-PRO SUBSTREAM=MIXED COMPS=CH4 FRACS=0.0

STREAM-REPOR MOLEFLOW MASSFLOW

