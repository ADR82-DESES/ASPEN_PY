TITLE 'Methanol Plant 10k TPD'

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C MASS-FLOW='KG/HR' MOLE-FLOW='KG/HR'

DEF-STREAMS CONV ALL

DATABANKS APV140 PURE32 / APV140 AQUEOUS

PROP-SOURCES APV140 PURE32 / APV140 AQUEOUS

COMPONENTS
    CH4 METHANE /
    H2O WATER /
    O2 OXYGEN /
    CO CARBON-MONOXIDE /
    CO2 CARBON-DIOXIDE /
    H2 HYDROGEN /
    CH3OH METHANOL /
    N2 NITROGEN /

PROPERTIES RK-SOAVE

FLOWSHEET
    BLOCK MIX-FEED IN=NG-FEED IN=STEAM IN=O2-FEED OUT=ATR-IN
    BLOCK B-ATR IN=ATR-IN OUT=HOT-SYN

STREAM NG-FEED
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 &
        MASS-FLOW=220000.0
    MASS-FRAC
        CH4 1.0 /

STREAM STEAM
    SUBSTREAM MIXED TEMP=250.0 PRES=35.0 &
        MASS-FLOW=148500.0
    MASS-FRAC
        H2O 1.0 /

STREAM O2-FEED
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 &
        MASS-FLOW=264000.0
    MASS-FRAC
        O2 1.0 /

STREAM ATR-IN
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 &
        MASS-FLOW=632500.0
    MASS-FRAC
        CH4 0.35 / &
        H2O 0.23 / &
        O2 0.42 /

STREAM HOT-SYN
    SUBSTREAM MIXED TEMP=1000.0 PRES=30.0 &
        MASS-FLOW=632500.0
    MASS-FRAC
        CO 0.4 / &
        H2 0.6 /

BLOCK MIX-FEED MIXER

BLOCK B-ATR RGIBBS
    PARAM
        TEMP=1000.0
        PRES=30.0