TITLE 'Methanol Plant'

IN-UNITS MET

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
          'APV140 INORGANIC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
             'APV140 INORGANIC'

COMPONENTS 
    CH4 CH4 /
    H2O H2O /
    O2 O2 /
    CO CO /
    CO2 CO2 /
    H2 H2 /
    MEOH CH3OH /
    N2 N2

PROPERTIES RK-SOAVE 

FLOWSHEET
    BLOCK MIXER1 IN=FEED1 FEED2 OUT=MIX1
    BLOCK REACT1 IN=MIX1 OUT=PROD1
    BLOCK COOL1 IN=PROD1 OUT=PROD2
    BLOCK SEP1 IN=PROD2 OUT=LIQ1 VAP1

STREAM FEED1
    SUBSTREAM MIXED TEMP=40 PRES=30 
    MASS-FLOW=100000
    MASS-FRAC CH4 1.0

STREAM FEED2
    SUBSTREAM MIXED TEMP=200 PRES=30
    MASS-FLOW=50000
    MASS-FRAC H2O 1.0

BLOCK MIXER1 MIXER

BLOCK REACT1 RGIBBS
    PARAM PRES=30 DUTY=0

BLOCK COOL1 HEATER
    PARAM TEMP=40 PRES=30

BLOCK SEP1 FLASH2
    PARAM PRES=30 DUTY=0

