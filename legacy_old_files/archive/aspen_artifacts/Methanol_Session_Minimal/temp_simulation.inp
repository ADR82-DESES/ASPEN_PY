TITLE 'Minimal Mixer IDEAL Test'

; Simplest possible simulation with IDEAL properties

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C FLOW='KG/HR'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC' / 'NOASPENPCD'

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC'

COMPONENTS
    H2 HYDROGEN /
    CO CARBON-MONOXIDE /

PROPERTIES IDEAL

FLOWSHEETING-OPTIONS
    MASS-BAL=YES ENERGY-BAL=YES

FLOWSHEET
    BLOCK B1 IN=FEED OUT=PROD

STREAM FEED
    SUBSTREAM MIXED TEMP=250.0 PRES=1.0 &
        MASS-FLOW=1000.0
    MOLE-FRAC
        H2 0.5 / &
        CO 0.5 /

STREAM PROD
    SUBSTREAM MIXED TEMP=250.0 PRES=1.0 &
        MASS-FLOW=1000.0
    MOLE-FRAC
        H2 0.5 / &
        CO 0.5 /

BLOCK B1 MIXER