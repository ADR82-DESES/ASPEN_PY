TITLE 'Test Syntax'
IN-UNITS MET PRESSURE=BAR TEMPERATURE=C FLOW='KG/HR'
DEF-STREAMS CONVEN ALL
DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC' / 'NOASPENPCD'
PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC'
COMPONENTS
    CH4 METHANE / H2O WATER / CO CARBON-MONOXIDE /
    CO2 CARBON-DIOXIDE / H2 HYDROGEN / CH3OH METHANOL
PROPERTIES RK-SOAVE
FLOWSHEET
    BLOCK MIX1 IN=S1 OUT=S2
    BLOCK B-SYN IN=S2 OUT=S3
STREAM S1
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0
    MASS-FLOW 220000.0
    MOLE-FRAC &
        CH4 1.0
BLOCK MIX1 MIXER
BLOCK B-SYN REQUIL
    PARAM TEMP=250.0 PRES=80.0
    REACTIONS RXN-SET1

REACTIONS RXN-SET1 EQUIL
    REAC-DATA 1
    STOIC 1 CO -1.0 / H2 -2.0 / CH3OH 1.0
    K-STOIC 1 12.28 -4048.0 0.0 0.0
