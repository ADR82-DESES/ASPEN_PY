PROP-SET PP-H2 PPMX UNITS='bara' SUBSTREAM=MIXED COMPS=H2 CO  &
        CO2 H2O MEOH PHASE=V 

STREAM S1 
    SUBSTREAM MIXED TEMP=493.2 <K> PRES=50.  &
        MASS-FLOW=2.8E-005 <kg/sec> 
    MOLE-FRAC H2 82. / CO 4. / CO2 3. / AR 11. 

BLOCK B1 RGIBBS 
    PARAM PRES=0. NPHASE=1 CHEMEQ=YES NREAC=2 MAXIT=50  &
        DUTY=0.0 
    PROD H2 / CO / CO2 / H2O / MEOH / AR 
    STOIC 1 H2 -1. / CO2 -1. / CO 1. / H2O 1. 
    STOIC 2 CO2 -1. / H2 -3. / MEOH 1. / H2O 1. 
    TAPP-SPEC 1 0.0 / 2 0.0 

BLOCK B3 RPLUG 
    PARAM TYPE=ADIABATIC LENGTH=0.15 DIAM=0.016 PRES=0.  &
        NPOINT=15 CATWT=34.8 <gm> CAT-PRESENT=YES  &
        BED-VOIDAGE=0.33 
    BLOCK-OPTION SIM-LEVEL=7 TERM-LEVEL=7 
    REPORT USERVECS KINETICS 
    PROP-REPORT PROPERTIES = PP-H2 
    SUBOBJECTS PROP = PP-H2 
    REACTIONS RXN-IDS=MEOH-SYN 
    ADV-PROFILES USE-SECTIONS=YES 
    PROF-SECT SECNO=1 SECT-NINTVL=4 FRAC-START=0. FRAC-END=0.1 /  &
        SECNO=2 SECT-NINTVL=6 FRAC-START=0.1 FRAC-END=0.4 /  &
        SECNO=3 SECT-NINTVL=5 FRAC-START=0.4 FRAC-END=1. 

BLOCK B2 DUPL 

EO-CONV-OPTI 

SENSITIVITY S-1 
    DEFINE XMPFR MOLE-FRAC STREAM=PLUG SUBSTREAM=MIXED  &
        COMPONENT=MEOH 
    DEFINE XMGIBBS MOLE-FRAC STREAM=GIBBS SUBSTREAM=MIXED  &
        COMPONENT=MEOH 
    TABULATE 1 "XMPFR" 
    TABULATE 2 "XMGIBBS" 
    VARY UNARY-PARAM VARIABLE=DGFORM ID1=MEOH ID2=1 
    RANGE OPT-LIST=OLIST LIST=-162300000. -1.65E-008 -1.66E-008 

STREAM-REPOR MOLEFLOW MASSFLOW MOLEFRAC MASSFRAC 

PROPERTY-REP NOPCES NOPROP-DATA NODFMS NOPARAM-PLUS 

REACTIONS MEOH-SYN GENERAL 
    PARAM NTERM-ADS=4 
    REAC-DATA 1 NAME=RWGS REAC-CLASS=LHHW PHASE=V  &
        CBASIS=PARTIALPRES RBASIS=CAT-WT REVERSIBLE=YES  &
        REV-METH=USER-SPEC PRES-UNIT="BAR" 
    REAC-DATA 2 NAME=MEOH-SYN REAC-CLASS=LHHW PHASE=V  &
        CBASIS=PARTIALPRES RBASIS=CAT-WT REVERSIBLE=YES  &
        REV-METH=USER-SPEC PRES-UNIT="BAR" 
    REAC-DATA 3 NAME=F-ETOH REAC-CLASS=POWERLAW PHASE=V  &
        STATUS=ON CBASIS=PARTIALPRES RBASIS=CAT-WT REVERSIBLE=NO  &
        PRES-UNIT="BAR" 
    REAC-DATA 4 NAME=DME-FORM PHASE=V STATUS=ON  &
        CBASIS=PARTIALPRES RBASIS=CAT-WT REVERSIBLE=NO PRES-UNIT= &
        "BAR" 
    RATE-CON 1 PRE-EXP=0.00165 ACT-ENERGY=22.6342 <kcal/mol>  &
        T-REF=228.42 
    RATE-CON 2 PRE-EXP=7.07034 ACT-ENERGY=-8.76469 <kcal/mol>  &
        T-REF=228.4200000 
    RATE-CON 3 PRE-EXP=1E-012 ACT-ENERGY=19.467 <kcal/mol>  &
        T-REF=228.42 
    RATE-CON 4 PRE-EXP=4.2E-011 ACT-ENERGY=18.66 <kcal/mol>  &
        T-REF=228.42 
    STOIC 1 MIXED CO2 -1. / H2 -1. / CO 1. / H2O 1. 
    STOIC 2 MIXED CO2 -1. / H2 -3. / MEOH 1. / H2O 1. 
    STOIC 3 MIXED CO -2. / H2 -4. / ETOH 1. / H2O 1. 
    STOIC 4 MIXED MEOH -2. / DME 1. / H2O 1. 
    DFORCE-EXP 1 MIXED CO2 1. 
    DFORCE-EXP 2 MIXED CO2 1. / MIXED H2 1. 
    DFORCE-EXP 3 MIXED CO 1. / MIXED H2 1.5 
    DFORCE-EXP 4 MIXED MEOH 0.55 
    DFORCE-EXP-2 1 MIXED H2 -1. / MIXED CO 1. / MIXED H2O  &
        1. 
    DFORCE-EXP-2 2 MIXED H2 -2. / MIXED MEOH 1. / MIXED  &
        H2O 1. 
    DFORCE-EQ-1 REACNO=1 A=0. B=0. / REACNO=2 A=0. 
    DFORCE-EQ-2 REACNO=1 A=-4.671945154 B=4773.258898 /  &
        REACNO=2 A=24.3889813 B=-7059.72589 
    ADSORP-EXP REACNO=1 CID=H2O SSID=MIXED EXPONENT=0. 1. 0.  &
        1. / REACNO=1 CID=H2 SSID=MIXED EXPONENT=0. -1. 0.5  &
        0. / REACNO=2 CID=H2O SSID=MIXED EXPONENT=0. 1. 0.  &
        1. / REACNO=2 CID=H2 SSID=MIXED EXPONENT=0. -1. 0.5  &
        0. 
    ADSORP-EQTER REACNO=1 TERM= 1 A=0. / REACNO=1 TERM= 2  &
        A=8.147108741 B=0. / REACNO=1 TERM= 3 A=-0.6951  &
        B=2068.3 / REACNO=1 TERM= 4 A=-23.438 B=14928.19686 /  &
        REACNO=2 TERM= 1 A=0. / REACNO=2 TERM= 2  &
        A=8.147108741 B=0. / REACNO=2 TERM= 3 A=-0.69515  &
        B=2068.3 / REACNO=2 TERM= 4 A=-23.43827453  &
        B=14928.19686 
    ADSORP-POW REACNO=1 EXPONENT=1. / REACNO=2 EXPONENT=3. 
    ACT-VAL ACTIVITY 
    SUBOBJECTS ACTIVITY = ACTIVITY 
    REAC-ACT 1 ACTIVITY=ACTIVITY / 2 ACTIVITY=ACTIVITY / 3  &
        ACTIVITY=ACTIVITY / 4 ACTIVITY=ACTIVITY 

PROP-TABLE PURE-1 PROPS 
    IN-UNITS SI MASS-FLOW='kg/hr' MOLE-FLOW='kmol/hr'  &
        VOLUME-FLOW='cum/hr' PRESSURE=bar TEMPERATURE=C DELTA-T=C  &
        PDROP-PER-HT='mbar/m' PDROP=bar SHORT-LENGTH=mm 
    ANALYSIS ANAL-TYPE=PURE PURE-PROP='G' UNITS='GJ/kmol'  &
        PURE-PHASES= V 
    MOLE-FLOW CO2 1 / H2 1 / H2O 1 / MEOH 1 / CO 1 
    PROPERTIES SRK FREE-WATER=STEAM-TA SOLU-WATER=3  &
        TRUE-COMPS=YES 
    VARY TEMP 
    RANGE VARVALUE=RANGE LOWER=200. UPPER=300. INCR=5. 
    VARY PRES 
    RANGE LIST=1.01325 
    PARAM 

PROP-TABLE PURE-2 PROPS 
    IN-UNITS SI MASS-FLOW='kg/hr' MOLE-FLOW='kmol/hr'  &
        VOLUME-FLOW='cum/hr' PRESSURE=bar DELTA-T=C  &
        PDROP-PER-HT='mbar/m' PDROP=bar SHORT-LENGTH=mm 
    ANALYSIS ANAL-TYPE=PURE PURE-PROP='CP' UNITS='kJ/kmol-K'  &
        PURE-PHASES= V 
    MOLE-FLOW MEOH 1 
    PROPERTIES SRK FREE-WATER=STEAMNBS SOLU-WATER=3  &
        TRUE-COMPS=YES 
    VARY TEMP 
    RANGE VARVALUE=RANGE LOWER=400. UPPER=600. INCR=5. 
    VARY PRES 
    RANGE LIST=50. 
    PARAM 

DISABLE 
    SENSITIVITY S-1 
;
