TITLE 'METHANOL PLANT 10K TPD'

; 10,000 TPD Grade AA Methanol via Autothermal Reforming (ATR)

IN-UNITS MET PRESSURE=BAR TEMPERATURE=C FLOW='KG/HR'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC' / 'NOASPENPCD'

PROP-SOURCES 'APV140 PURE32' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / &
        'APV140 INORGANIC'

COMPONENTS
    CH4 METHANE /
    H2O WATER /
    O2 OXYGEN /
    CO CARBON-MONOXIDE /
    CO2 CARBON-DIOXIDE /
    H2 HYDROGEN /
    CH3OH METHANOL /
    N2 NITROGEN /

PROPERTIES RK-SOAVE

FLOWSHEET
    BLOCK MIX-FEED IN=NG-FEED STEAM O2-FEED OUT=ATR-IN
    BLOCK B-ATR IN=ATR-IN OUT=HOT-SYN
    BLOCK B-COOL IN=HOT-SYN OUT=COLD-SYN
    BLOCK B-FLASH IN=COLD-SYN OUT=DRY-GAS WATER-DR
    BLOCK B-COMP IN=DRY-GAS OUT=HP-GAS
    BLOCK MIX-LOOP IN=HP-GAS RECYCLE OUT=R-IN
    BLOCK B-SYN IN=R-IN OUT=R-OUT
    BLOCK B-SEP IN=R-OUT OUT=GAS-PURG CRUDE-ME
    BLOCK SPLIT IN=GAS-PURG OUT=PURGE RECYCLE
    BLOCK B-DIST IN=CRUDE-ME OUT=MEOH-PRO WASTE-H2

STREAM NG-FEED
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 MASS-FLOW=220000.0
    MOLE-FRAC CH4 1.0

STREAM STEAM
    SUBSTREAM MIXED TEMP=250.0 PRES=35.0 MASS-FLOW=148500.0
    MOLE-FRAC H2O 1.0

STREAM O2-FEED
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 MASS-FLOW=264000.0
    MOLE-FRAC O2 0.995
    MOLE-FRAC N2 0.005

STREAM ATR-IN
    SUBSTREAM MIXED TEMP=150.0 PRES=30.0 MASS-FLOW=632500.0
    MOLE-FRAC CH4 0.455
    MOLE-FRAC H2O 0.273
    MOLE-FRAC O2 0.271
    MOLE-FRAC N2 0.001

STREAM HOT-SYN
    SUBSTREAM MIXED TEMP=1000.0 PRES=30.0 MASS-FLOW=632500.0
    MOLE-FRAC H2 0.48
    MOLE-FRAC CO 0.18
    MOLE-FRAC CO2 0.09
    MOLE-FRAC H2O 0.2
    MOLE-FRAC CH4 0.05

STREAM COLD-SYN
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 MASS-FLOW=632500.0
    MOLE-FRAC H2 0.48
    MOLE-FRAC CO 0.18
    MOLE-FRAC CO2 0.09
    MOLE-FRAC H2O 0.2
    MOLE-FRAC CH4 0.05

STREAM DRY-GAS
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 MASS-FLOW=520000.0
    MOLE-FRAC H2 0.62
    MOLE-FRAC CO 0.2
    MOLE-FRAC CO2 0.1
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM WATER-DR
    SUBSTREAM MIXED TEMP=40.0 PRES=30.0 MASS-FLOW=112500.0
    MOLE-FRAC H2O 0.985
    MOLE-FRAC CH3OH 0.005
    MOLE-FRAC CO2 0.005
    MOLE-FRAC CH4 0.005

STREAM HP-GAS
    SUBSTREAM MIXED TEMP=120.0 PRES=80.0 MASS-FLOW=520000.0
    MOLE-FRAC H2 0.62
    MOLE-FRAC CO 0.2
    MOLE-FRAC CO2 0.1
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM RECYCLE
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 MASS-FLOW=1558000.0
    MOLE-FRAC H2 0.66
    MOLE-FRAC CO 0.14
    MOLE-FRAC CO2 0.12
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM R-IN
    SUBSTREAM MIXED TEMP=220.0 PRES=80.0 MASS-FLOW=2078000.0
    MOLE-FRAC H2 0.65
    MOLE-FRAC CO 0.155
    MOLE-FRAC CO2 0.115
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM R-OUT
    SUBSTREAM MIXED TEMP=250.0 PRES=80.0 MASS-FLOW=2090000.0
    MOLE-FRAC H2 0.58
    MOLE-FRAC CO 0.1
    MOLE-FRAC CO2 0.11
    MOLE-FRAC CH4 0.07
    MOLE-FRAC H2O 0.08
    MOLE-FRAC CH3OH 0.06

STREAM GAS-PURG
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 MASS-FLOW=1640000.0
    MOLE-FRAC H2 0.66
    MOLE-FRAC CO 0.14
    MOLE-FRAC CO2 0.12
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM CRUDE-ME
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 MASS-FLOW=460000.0
    MOLE-FRAC CH3OH 0.905
    MOLE-FRAC H2O 0.085
    MOLE-FRAC CO2 0.005
    MOLE-FRAC CO 0.003
    MOLE-FRAC H2 0.002

STREAM PURGE
    SUBSTREAM MIXED TEMP=40.0 PRES=80.0 MASS-FLOW=82000.0
    MOLE-FRAC H2 0.66
    MOLE-FRAC CO 0.14
    MOLE-FRAC CO2 0.12
    MOLE-FRAC CH4 0.06
    MOLE-FRAC H2O 0.02

STREAM MEOH-PRO
    SUBSTREAM MIXED TEMP=40.0 PRES=1.5 MASS-FLOW=416666.7
    MOLE-FRAC CH3OH 0.9985
    MOLE-FRAC H2O 0.001
    MOLE-FRAC CO2 0.0003
    MOLE-FRAC CO 0.0001
    MOLE-FRAC CH4 0.0001

STREAM WASTE-H2
    SUBSTREAM MIXED TEMP=45.0 PRES=1.2 MASS-FLOW=43333.3
    MOLE-FRAC H2O 0.96
    MOLE-FRAC CH3OH 0.03
    MOLE-FRAC CO2 0.005
    MOLE-FRAC CO 0.003
    MOLE-FRAC H2 0.002

BLOCK MIX-FEED MIXER

BLOCK B-ATR RGIBBS
    PARAM TEMP=1000.0 PRES=30.0

BLOCK B-COOL HEATER
    PARAM TEMP=40.0 PRES=0.0

BLOCK B-FLASH FLASH2
    PARAM TEMP=40.0 PRES=0.0

BLOCK B-COMP COMPR
    PARAM PRES=80.0 TYPE=ISENTROPIC SEFF=0.85

BLOCK MIX-LOOP MIXER

BLOCK B-SYN RGIBBS
    PARAM TEMP=250.0 PRES=80.0

BLOCK B-SEP FLASH2
    PARAM TEMP=40.0 PRES=0.0

BLOCK SPLIT FSPLIT
    FRAC RECYCLE 0.95
    FRAC PURGE 0.05

BLOCK B-DIST SEP
    FRAC STRM=MEOH-PRO COMP=CH3OH FRAC=0.99
    FRAC STRM=MEOH-PRO COMP=H2O FRAC=0.001
